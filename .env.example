# Copy to .env and fill in. Never commit .env.

# --- pretix ---
# Pin a release for production (e.g. 2024.10.0) instead of "stable".
PRETIX_VERSION=stable
PRETIX_DOMAIN=tickets.example.com
PRETIX_URL=https://${PRETIX_DOMAIN}
PRETIX_INSTANCE_NAME=My Ticket Shop
PRETIX_CURRENCY=EUR
CRON_INTERVAL_SECONDS=900

# --- PostgreSQL ---
POSTGRES_DB=pretix
POSTGRES_USER=pretix
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Outgoing mail: bundled Postfix service (`smtp`) ---
# MAIL_FROM must be an address on MAIL_DOMAIN.
MAIL_DOMAIN=example.com
MAIL_FROM=tickets@example.com
# Must match the server's reverse DNS (PTR) and have an A record.
SMTP_HOSTNAME=mail.example.com
# Pin a boky/postfix tag for production.
SMTP_VERSION=latest
# Optional upstream relay (e.g. [smtp.provider.com]:587). Empty = deliver directly.
SMTP_RELAYHOST=
SMTP_RELAYHOST_USERNAME=
SMTP_RELAYHOST_PASSWORD=

# --- pretix -> SMTP connection ---
# Defaults talk to the bundled service. Override only to use an external SMTP
# directly (then also set MAIL_PORT=587, MAIL_TLS=on and credentials).
MAIL_HOST=smtp
MAIL_PORT=25
MAIL_USER=
MAIL_PASSWORD=
MAIL_TLS=off
MAIL_SSL=off
